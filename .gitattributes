# Normalise line endings. Dev is Windows, CI is Linux; without this every diff
# eventually fills with phantom whole-file changes.
* text=auto eol=lf

# Windows-only files that must keep CRLF or they break.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# The submission-fidelity corpus is byte evidence, not source. `text=auto` above
# would rewrite `crlf-line-endings.py` to LF on the way into a commit — measured:
# the filtered blob is 51 bytes and the raw one 56 — which silently deletes the
# only property that fixture exists to have, on every fresh clone including CI.
# `-text` disables the filter in both directions. `.editorconfig` carries the
# matching exemption for editors; `test/fixtures/README.md` says why.
test/fixtures/submission-corpus/**  -text

# Binary — never munge, never diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.vsix  binary
*.woff  binary
*.woff2 binary

# Generated/vendored: keep out of language stats and collapse in review.
src/connection/rest/api/**  linguist-generated=true
docs/reference/**           linguist-generated=true

# Lockfiles: diffable but not worth reviewing line by line.
package-lock.json  -diff
