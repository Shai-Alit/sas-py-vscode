# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
out/
dist/
*.vsix
*.tsbuildinfo

# Test and coverage artefacts
.nyc_output/
coverage/
.vscode-test/
.vscode-test-web/
test-results/

# Throwaway test files. Excluded from tsconfig.test.json, ESLint, and the
# copyright check as well — all four have to agree, or the exemption is a trap.
test/scratch/

# Localisation build output (l10n/bundle.l10n.json is generated, not authored)
l10n/bundle.l10n.json

# Generated documentation output
site/

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/

# Machine-local Claude Code configuration. The working agreements themselves —
# CLAUDE.md, HOUSEKEEPING.md and .claude/skills/ — are tracked deliberately,
# because both the Desktop agent and the VS Code window must read the same
# rules. settings.local.json is the exception: it holds one checkout's tool
# permissions and additional directories, which are specific to a machine and
# would fight between contributors.
.claude/settings.local.json

# Python bytecode (the Codex reviewer script is stdlib Python)
__pycache__/
*.py[cod]

# Secrets and local configuration — nothing in this group may ever be committed.
# creds.json in particular holds live Viya bearer tokens used for probing.
creds.json
.env
.env.*
*.pem
*.key
*.pfx
.saspy-local/

# VitePress build cache
docs/.vitepress/cache/
docs/.vitepress/.temp/

# Transient files written by scripts/check-docs-samples.mjs
__docs-sample-*.ts
