{
  // The live tier gets its own config file rather than a `--spec` override on
  // the command line, because `--spec` does not replace the `spec` in
  // `.mocharc.json` — Mocha merges the two, and `npm run test:live` would
  // quietly run the unit suite as well. Verified, not assumed.
  "spec": ["out/test/live/**/*.test.js"],

  "node-option": ["enable-source-maps"],

  // These tests cross a network to a real deployment. Two seconds is the right
  // number for a unit test and the wrong one here.
  "timeout": 30000,

  // Deliberately absent: `fail-zero`. A machine with no Viya to point at should
  // report skips, not a failure.
  //
  // Today that would hold even with the flag on, because these suites register
  // a pending test and Mocha counts pending tests as encountered. The flag stays
  // off for the pattern one refactor away: a `describe` that reads the gate and
  // returns before registering any `it` produces a genuinely empty run, and on
  // an unconfigured machine that is the correct outcome rather than an error.
  "color": true
}
