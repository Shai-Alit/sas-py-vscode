{
  "name": "python-on-viya",
  "displayName": "Python on Viya",
  "description": "Write Python locally and run it on SAS Viya, using the Python environment managed inside Viya.",
  "version": "0.0.1",
  "publisher": "shai-alit",
  "license": "Apache-2.0",
  "author": "Sean Ford",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Shai-Alit/sas-py-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Shai-Alit/sas-py-vscode/issues"
  },
  "homepage": "https://github.com/Shai-Alit/sas-py-vscode#readme",
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=22.18.0"
  },
  "allowScripts": {
    "@vscode/vsce-sign": false,
    "esbuild": false,
    "fsevents": false,
    "keytar": false,
    "msw": false
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "sas",
    "viya",
    "python",
    "remote execution",
    "compute"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Editing, syntax, and connection-profile management work in untrusted folders. Connecting to SAS Viya, reading stored credentials, and executing code require a trusted workspace, because they run code on a remote server under your identity.",
      "restrictedConfigurations": [
        "pythonOnViya.connectionProfiles",
        "pythonOnViya.defaultProfile"
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "authentication": [
      {
        "id": "pythonOnViya",
        "label": "%authentication.label%"
      }
    ],
    "commands": [
      {
        "command": "pythonOnViya.showOutputChannel",
        "title": "%command.showOutputChannel.title%",
        "category": "%extension.category%"
      },
      {
        "command": "pythonOnViya.addProfile",
        "title": "%command.addProfile.title%",
        "category": "%extension.category%"
      },
      {
        "command": "pythonOnViya.editProfile",
        "title": "%command.editProfile.title%",
        "category": "%extension.category%",
        "enablement": "pythonOnViya.hasProfiles"
      },
      {
        "command": "pythonOnViya.deleteProfile",
        "title": "%command.deleteProfile.title%",
        "category": "%extension.category%",
        "enablement": "pythonOnViya.hasProfiles"
      },
      {
        "command": "pythonOnViya.switchProfile",
        "title": "%command.switchProfile.title%",
        "category": "%extension.category%",
        "enablement": "pythonOnViya.hasProfiles"
      },
      {
        "command": "pythonOnViya.importProfiles",
        "title": "%command.importProfiles.title%",
        "category": "%extension.category%"
      },
      {
        "command": "pythonOnViya.signIn",
        "title": "%command.signIn.title%",
        "category": "%extension.category%",
        "enablement": "pythonOnViya.hasProfiles && isWorkspaceTrusted"
      },
      {
        "command": "pythonOnViya.signOut",
        "title": "%command.signOut.title%",
        "category": "%extension.category%",
        "enablement": "pythonOnViya.hasProfiles && isWorkspaceTrusted"
      },
      {
        "command": "pythonOnViya.connect",
        "title": "%command.connect.title%",
        "category": "%extension.category%",
        "enablement": "pythonOnViya.hasProfiles && isWorkspaceTrusted && !pythonOnViya.connected"
      },
      {
        "command": "pythonOnViya.disconnect",
        "title": "%command.disconnect.title%",
        "category": "%extension.category%",
        "enablement": "pythonOnViya.connected"
      },
      {
        "command": "pythonOnViya.selectRunTarget",
        "title": "%command.selectRunTarget.title%",
        "category": "%extension.category%"
      },
      {
        "command": "pythonOnViya.runFile",
        "title": "%command.runFile.title%",
        "category": "%extension.category%",
        "icon": "$(play)"
      },
      {
        "command": "pythonOnViya.runSelection",
        "title": "%command.runSelection.title%",
        "category": "%extension.category%"
      },
      {
        "command": "pythonOnViya.cancelRun",
        "title": "%command.cancelRun.title%",
        "category": "%extension.category%",
        "enablement": "pythonOnViya.running"
      },
      {
        "command": "pythonOnViya.resetPythonState",
        "title": "%command.resetPythonState.title%",
        "category": "%extension.category%"
      },
      {
        "command": "pythonOnViya.showEnvironment",
        "title": "%command.showEnvironment.title%",
        "category": "%extension.category%"
      },
      {
        "command": "pythonOnViya.refreshEnvironment",
        "title": "%command.refreshEnvironment.title%",
        "category": "%extension.category%"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "pythonOnViya.runFile",
          "when": "editorLangId == python && pythonOnViya.runTarget == viya && isWorkspaceTrusted",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "pythonOnViya.runFile",
          "when": "editorLangId == python && pythonOnViya.runTarget == viya && isWorkspaceTrusted",
          "group": "pythonOnViya@1"
        },
        {
          "command": "pythonOnViya.runSelection",
          "when": "editorLangId == python && pythonOnViya.runTarget == viya && isWorkspaceTrusted && editorHasSelection",
          "group": "pythonOnViya@2"
        }
      ]
    },
    "configuration": {
      "title": "Python on Viya",
      "properties": {
        "pythonOnViya.connectionProfiles": {
          "type": "object",
          "default": {},
          "scope": "window",
          "markdownDescription": "%configuration.connectionProfiles.description%",
          "additionalProperties": {
            "type": "object",
            "required": [
              "endpoint"
            ],
            "additionalProperties": false,
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1,
                "default": 1,
                "markdownDescription": "%configuration.profile.version.description%"
              },
              "id": {
                "type": "string",
                "markdownDescription": "%configuration.profile.id.description%"
              },
              "endpoint": {
                "type": "string",
                "pattern": "^[^@]*$",
                "patternErrorMessage": "%configuration.profile.endpoint.patternError%",
                "markdownDescription": "%configuration.profile.endpoint.description%"
              },
              "context": {
                "type": "string",
                "markdownDescription": "%configuration.profile.context.description%"
              },
              "clientId": {
                "type": "string",
                "markdownDescription": "%configuration.profile.clientId.description%"
              }
            }
          }
        },
        "pythonOnViya.defaultProfile": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "%configuration.defaultProfile.description%"
        },
        "pythonOnViya.userProvidedCertificates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine",
          "markdownDescription": "%configuration.userProvidedCertificates.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run l10n:extract && npm run build -- --production",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "compile:test": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile:test && mocha",
    "test:integration": "npm run build && npm run compile:test && node out/test/integration/runTest.js",
    "test:live": "npm run compile:test && mocha --config .mocharc.live.json",
    "coverage": "npm run compile:test && c8 mocha",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:copyright": "node scripts/check-copyright.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:coverage-scope": "node scripts/check-coverage-scope.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:docs": "npm run docs:reference:check && npm run docs:samples && npm run docs:links:self && npm run docs:build",
    "docs:reference": "node scripts/generate-reference.mjs",
    "docs:reference:check": "node scripts/generate-reference.mjs --check",
    "docs:samples": "node scripts/check-docs-samples.mjs",
    "docs:links": "node scripts/check-links.mjs",
    "docs:links:self": "node scripts/check-links.mjs --self-only",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "l10n:extract": "vscode-l10n-dev export --outDir ./l10n ./src",
    "package": "vsce package --out dist/python-on-viya.vsix && npm run check:package",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check:copyright && npm run check:secrets && npm run check:coverage-scope && npm run check:contracts && npm run build && npm run coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "22.18.13",
    "@types/sinon": "22.0.0",
    "@types/vscode": "1.104.0",
    "@vscode/l10n-dev": "0.0.35",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "c8": "12.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "js-yaml": "5.4.1",
    "mocha": "11.8.0",
    "msw": "2.15.0",
    "prettier": "3.9.6",
    "sinon": "22.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "^6.4.3",
    "serialize-javascript": "^7.0.5",
    "qs": "^6.16.0",
    "fast-uri": "^3.1.6"
  }
}
